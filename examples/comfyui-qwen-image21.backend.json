{
  "kind": "comfyui",
  "auth_mode": "none",
  "base_url": "http://127.0.0.1:8188",
  "timeout_seconds": 21600,
  "poll_seconds": 3,
  "defaults": {
    "seed": 42
  },
  "templates": {
    "qwen-image21-q4-512-v1": {
      "workflow": {
        "1": {
          "class_type": "UnetLoaderGGUFAdvanced",
          "inputs": {
            "unet_name": "qwen_image_2.1_Q4_K_M.gguf",
            "dequant_dtype": "float32",
            "patch_dtype": "float32",
            "patch_on_device": false
          }
        },
        "2": {
          "class_type": "CLIPLoader",
          "inputs": {
            "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
            "type": "qwen_image",
            "device": "cpu"
          }
        },
        "3": {
          "class_type": "TextEncodeQwenImage21",
          "inputs": {
            "clip": [
              "2",
              0
            ],
            "prompt": "",
            "negative_prompt": "",
            "resolution": 512
          }
        },
        "4": {
          "class_type": "VAELoader",
          "inputs": {
            "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
          }
        },
        "5": {
          "class_type": "QwenImage21Cache",
          "inputs": {
            "model": [
              "1",
              0
            ],
            "device": "off",
            "dtype": "default"
          }
        },
        "6": {
          "class_type": "KSampler",
          "inputs": {
            "model": [
              "5",
              0
            ],
            "positive": [
              "3",
              0
            ],
            "negative": [
              "3",
              1
            ],
            "latent_image": [
              "3",
              2
            ],
            "seed": 42,
            "steps": 25,
            "cfg": 1.0,
            "sampler_name": "euler",
            "scheduler": "simple",
            "denoise": 1.0
          }
        },
        "7": {
          "class_type": "VAEDecode",
          "inputs": {
            "samples": [
              "6",
              0
            ],
            "vae": [
              "4",
              0
            ]
          }
        },
        "8": {
          "class_type": "SaveImage",
          "inputs": {
            "images": [
              "7",
              0
            ],
            "filename_prefix": "PacketFoundry-Qwen21"
          }
        }
      },
      "mappings": [
        {
          "node": "3",
          "input": "prompt",
          "source": "prompt"
        },
        {
          "node": "6",
          "input": "seed",
          "source": "parameter:seed"
        }
      ],
      "output_nodes": [
        "8"
      ]
    }
  }
}
