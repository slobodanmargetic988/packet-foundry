  "components": {
    "schemas": {
      "ArtifactRef": {
        "properties": {
          "artifact_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$",
            "title": "Artifact Id"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Size Bytes"
          },
          "mime_type": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Mime Type"
          },
          "filename": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "artifact_id",
          "sha256",
          "size_bytes",
          "mime_type"
        ],
        "title": "ArtifactRef"
      },
      "AttemptToken": {
        "properties": {
          "factory_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$",
            "title": "Factory Id"
          },
          "fencing_token": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Fencing Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "factory_id",
          "fencing_token"
        ],
        "title": "AttemptToken"
      },
      "Completion": {
        "properties": {
          "factory_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$",
            "title": "Factory Id"
          },
          "fencing_token": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Fencing Token"
          },
          "result": {
            "$ref": "#/components/schemas/ResultPackage"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "factory_id",
          "fencing_token",
          "result"
        ],
        "title": "Completion"
      },
      "EnrollmentCreate": {
        "properties": {
          "factory_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$",
            "title": "Factory Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "factory_id",
          "name"
        ],
        "title": "EnrollmentCreate"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Code"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo"
      },
      "ExecutionProfile": {
        "properties": {
          "profile_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$",
            "title": "Profile Id"
          },
          "model": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Model"
          },
          "backend": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$",
            "title": "Backend"
          },
          "operations": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$"
            },
            "type": "array",
            "minItems": 1,
            "title": "Operations"
          },
          "output_kinds": {
            "items": {
              "type": "string",
              "enum": [
                "text",
                "json",
                "image",
                "audio",
                "video"
              ]
            },
            "type": "array",
            "minItems": 1,
            "title": "Output Kinds"
          },
          "input_kinds": {
            "items": {
              "type": "string",
              "enum": [
                "text",
                "json",
                "image",
                "audio",
                "video",
                "document"
              ]
            },
            "type": "array",
            "title": "Input Kinds"
          },
          "resource_group": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$",
            "title": "Resource Group",
            "default": "default"
          },
          "supports_live": {
            "type": "boolean",
            "title": "Supports Live",
            "default": true
          },
          "accept_experiments": {
            "type": "boolean",
            "title": "Accept Experiments",
            "default": false
          },
          "templates": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$"
            },
            "type": "array",
            "title": "Templates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "profile_id",
          "model",
          "backend"
        ],
        "title": "ExecutionProfile"
      },
      "FactoryRegistration": {
        "properties": {
          "factory_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$",
            "title": "Factory Id"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/ExecutionProfile"
            },
            "type": "array",
            "minItems": 1,
            "title": "Profiles"
          },
          "resource_groups": {
            "patternProperties": {
              "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$": {
                "type": "integer",
                "maximum": 256.0,
                "minimum": 1.0
              }
            },
            "propertyNames": {
              "maxLength": 128,
              "minLength": 1
            },
            "type": "object",
            "title": "Resource Groups"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "factory_id",
          "name",
          "profiles"
        ],
        "title": "FactoryRegistration"
      },
      "Failure": {
        "properties": {
          "factory_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:-][A-Za-z0-9_.:-]*$",
            "title": "Factory Id"
          },
          "fencing_token": {
            "type": "integer",
